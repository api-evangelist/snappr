      "name": "Coverage",
      "description": {
        "content": "Check Snappr coverage for a location and shoot type.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0e5d4a29-1150-4865-a6f0-4bdddfc5454f",
          "name": "Get Coverage",
          "request": {
            "name": "Get Coverage",
            "description": {
              "content": "Returns Snappr coverage status (boolean) for a given location and shoot type. Coverage status is independent of specific dates or times. Provide either an address, or latitude and longitude.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "coverage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "latitude",
                  "value": "<number>",
                  "description": "Latitude of the shoot location."
                },
                {
                  "disabled": false,
                  "key": "longitude",
                  "value": "<number>",
                  "description": "Longitude of the shoot location."
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "Address of the shoot location. Must be a Google Maps valid address."
                },
                {
                  "disabled": false,
                  "key": "shoottype",
                  "value": "<string>",
                  "description": "(Required) Name of the shoot type (e.g. \"event\")."
                },
                {
                  "disabled": false,
                  "key": "creator_id",
                  "value": "<string>",
                  "description": "Identifier of a creator, to check coverage for a specific creator."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
