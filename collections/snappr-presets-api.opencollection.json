{
  "opencollection": "1.0.0",
  "info": {
    "name": "Snappr Availability Presets API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Presets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Presets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.snappr.com/presets",
            "headers": [
              {
                "name": "accept-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset used for pagination. Defaults to 0."
              }
            ]
          },
          "docs": "Retrieves all editing presets defined in the Photography Portal."
        }
      ]
    }
  ],
  "bundled": true
}